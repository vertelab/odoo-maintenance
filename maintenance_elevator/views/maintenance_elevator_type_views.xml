<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Reference data
         ================================================================ -->

    <record id="view_maintenance_elevator_type_list" model="ir.ui.view">
        <field name="name">maintenance.elevator.type.list</field>
        <field name="model">maintenance.elevator.type</field>
        <field name="arch" type="xml">
            <list string="Elevator Reference Data" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_type"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_elevator_type_form" model="ir.ui.view">
        <field name="name">maintenance.elevator.type.form</field>
        <field name="model">maintenance.elevator.type</field>
        <field name="arch" type="xml">
            <form string="Elevator Reference Data">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="model_type"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Internal note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maintenance_elevator_type_search" model="ir.ui.view">
        <field name="name">maintenance.elevator.type.search</field>
        <field name="model">maintenance.elevator.type</field>
        <field name="arch" type="xml">
            <search string="Elevator Reference Data">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_model_type" string="Reference Type"
                        context="{'group_by': 'model_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_maintenance_elevator_type" model="ir.actions.act_window">
        <field name="name">Elevator Reference Data</field>
        <field name="res_model">maintenance.elevator.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a reference value
            </p>
            <p>
                Elevator types, mechanical brands, control systems, door
                types, bearing configurations, lubrication types, GSM
                devices and emergency phone types.
            </p>
        </field>
    </record>

    <menuitem id="menu_maintenance_elevator_type"
              name="Elevator Reference Data"
              parent="maintenance.menu_maintenance_configuration"
              action="action_maintenance_elevator_type"
              sequence="90"/>

</odoo>
