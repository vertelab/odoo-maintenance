<odoo>
    <data>
        <record id="server_maintenance_form_view" model="ir.ui.view">
            <field name="name">maintenance.equipment.form</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']/button[1]" position="before">
                    <button name="view_server_log" class="btn btn-secondary" string="Server Log" type="object" icon="fa-server" invisible="not is_monitored"/>
                    <button name="server_auto_sync" class="btn btn-secondary" string="Ping Server" type="object" icon="fa-globe" invisible="not is_monitored"/>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <div class="oe_right">
                        <field name="monitor_is_running" class="oe_inline" widget="state_selection" invisible="not is_monitored"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='maintenance_team_id']" position="after">
                    <field name="is_monitored"/>
                    <field name="monitor_url" invisible="not is_monitored"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
