<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_equipment_form_iot" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.iot</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_sensors" type="object"
                        class="oe_stat_button" icon="fa-signal"
                        invisible="not sensor_count">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="sensor_count"/></span>
                        <span class="o_stat_text">Sensors</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Sensors" name="sensors">
                    <group>
                        <group>
                            <field name="sensor_state" widget="badge"
                                   decoration-success="sensor_state == 'ok'"
                                   decoration-warning="sensor_state == 'warning'"
                                   decoration-danger="sensor_state == 'critical'"/>
                            <field name="sensor_critical_count"
                                   invisible="not sensor_critical_count"/>
                        </group>
                    </group>
                    <field name="sensor_ids">
                        <list decoration-danger="sensor_state == 'critical'"
                              decoration-warning="sensor_state == 'warning'">
                            <field name="name"/>
                            <field name="sensor_type" widget="badge"/>
                            <field name="last_value"/>
                            <field name="unit"/>
                            <field name="last_reading_date" widget="datetime"/>
                            <field name="sensor_state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
