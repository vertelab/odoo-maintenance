<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Sensors
         ================================================================ -->
    <record id="maintenance_sensor_list" model="ir.ui.view">
        <field name="name">maintenance.sensor.list</field>
        <field name="model">maintenance.sensor</field>
        <field name="arch" type="xml">
            <list decoration-danger="sensor_state == 'critical'"
                  decoration-warning="sensor_state == 'warning'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="sensor_type" widget="badge"/>
                <field name="last_value"/>
                <field name="unit"/>
                <field name="last_reading_date" widget="datetime"/>
                <field name="sensor_state" widget="badge"
                       decoration-success="sensor_state == 'ok'"
                       decoration-warning="sensor_state == 'warning'"
                       decoration-danger="sensor_state == 'critical'"/>
            </list>
        </field>
    </record>

    <record id="maintenance_sensor_form" model="ir.ui.view">
        <field name="name">maintenance.sensor.form</field>
        <field name="model">maintenance.sensor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Door cycles..."/></h1>
                    </div>
                    <group>
                        <group string="Sensor">
                            <field name="equipment_id" options="{'no_create': True}"/>
                            <field name="sensor_type"/>
                            <field name="unit"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Thresholds">
                            <field name="threshold_direction"/>
                            <field name="warning_threshold"/>
                            <field name="critical_threshold"/>
                        </group>
                    </group>
                    <group string="Latest">
                        <group>
                            <field name="last_value"/>
                            <field name="last_reading_date"/>
                        </group>
                        <group>
                            <field name="sensor_state" widget="badge"
                                   decoration-success="sensor_state == 'ok'"
                                   decoration-warning="sensor_state == 'warning'"
                                   decoration-danger="sensor_state == 'critical'"/>
                            <field name="reading_count"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readings" name="readings">
                            <field name="reading_ids">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="value"/>
                                    <field name="maintenance_request_id"
                                           invisible="not maintenance_request_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="maintenance_sensor_search" model="ir.ui.view">
        <field name="name">maintenance.sensor.search</field>
        <field name="model">maintenance.sensor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_id"/>
                <filter name="filter_critical" string="Critical"
                        domain="[('sensor_state', '=', 'critical')]"/>
                <filter name="filter_warning" string="True"
                        domain="[('sensor_state', 'in', ('warning', 'critical'))]"/>
                <filter name="filter_no_data" string="No Data"
                        domain="[('sensor_state', '=', 'no_data')]"/>
                <separator/>
                <filter name="group_by_equipment" string="Elevator"
                        context="{'group_by': 'equipment_id'}"/>
                <filter name="group_by_type" string="Sensor Type"
                        context="{'group_by': 'sensor_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_maintenance_sensors" model="ir.actions.act_window">
        <field name="name">Sensors</field>
        <field name="res_model">maintenance.sensor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sensors yet
            </p>
            <p>
                A sensor is a measured value on an equipment record. The connector
                writes readings; thresholds and alarms are handled here.
            </p>
        </field>
    </record>

</odoo>
