<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Templates
         ================================================================ -->

    <record id="inspection_template_list" model="ir.ui.view">
        <field name="name">maintenance.inspection.template.list</field>
        <field name="model">maintenance.inspection.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="inspection_type" widget="badge"/>
                <field name="line_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="inspection_template_form" model="ir.ui.view">
        <field name="name">maintenance.inspection.template.form</field>
        <field name="model">maintenance.inspection.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Annual inspection..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="inspection_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="When this template applies..."/>
                    </group>
                    <notebook>
                        <page string="Check Points" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="instruction"/>
                                    <field name="is_mandatory"/>
                                    <field name="allow_red_remark"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="inspection_template_search" model="ir.ui.view">
        <field name="name">maintenance.inspection.template.search</field>
        <field name="model">maintenance.inspection.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_by_category" string="Category"
                        context="{'group_by': 'category_id'}"/>
                <filter name="group_by_type" string="Inspection Type"
                        context="{'group_by': 'inspection_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_inspection_template" model="ir.actions.act_window">
        <field name="name">Inspection Templates</field>
        <field name="res_model">maintenance.inspection.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first inspection template
            </p>
            <p>
                A template lists what to check on an asset of a given
                category. An inspection copies those points, so editing the
                template later does not rewrite finished protocols.
            </p>
        </field>
    </record>

</odoo>
